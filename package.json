{
  "name": "jumble-api",
  "version": "1.0.0",
  "description": "JumbleAPI is a configless api to help frontend developers test how their application behaves under certain situations. It has options to save a schema, set delays for responses, return a certain or random status code, missing keys, wrong types, and malformed data. A simple API for generating random data using Faker.js and validating it with AJV. ",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/app.ts --schema schemas.js",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": {
    "jumble-api": "./dist/app.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "jumble",
    "api",
    "typescript",
    "express",
    "nodejs"
  ],
  "author": "Masato Mizunuma (Mizuto911)",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
